{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bettermework.com/schemas/openathlete-training-plan-import-v1.json",
  "title": "OpenAthlete Training Plan Import v1",
  "description": "Versioned JSON format for importing contiguous planned training weeks into this OpenAthlete fork.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "program"],
  "properties": {
    "schemaVersion": {
      "const": "1.0",
      "description": "Schema version. Increment this when the import contract changes."
    },
    "program": { "$ref": "#/$defs/program" }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Calendar date in YYYY-MM-DD format."
    },
    "sport": {
      "enum": [
        "RUNNING",
        "TRAIL_RUNNING",
        "CYCLING",
        "SWIMMING",
        "ROCK_CLIMBING",
        "HIKING",
        "STRENGTH",
        "CROSSFIT",
        "YOGA",
        "ALPINE_SKI",
        "BACKCOUNTRY_SKI",
        "BADMINTON",
        "CANOEING",
        "E_BIKE_RIDE",
        "ELLIPTICAL",
        "E_MOUNTAIN_BIKE_RIDE",
        "GOLF",
        "GRAVEL_RIDE",
        "HANDCYCLE",
        "HIGH_INTENSITY_INTERVAL_TRAINING",
        "ICE_SKATE",
        "INLINE_SKATE",
        "KAYAKING",
        "KITESURF",
        "MOUNTAIN_BIKE_RIDE",
        "NORDIC_SKI",
        "PICKLEBALL",
        "PILATES",
        "RACQUETBALL",
        "ROLLER_SKI",
        "ROWING",
        "SAIL",
        "SKATEBOARD",
        "SNOWBOARD",
        "SNOWSHOE",
        "SOCCER",
        "SQUASH",
        "STAIR_STEPPER",
        "STAND_UP_PADDLING",
        "SURFING",
        "TABLE_TENNIS",
        "TENNIS",
        "VELOMOBILE",
        "VIRTUAL_RIDE",
        "VIRTUAL_ROW",
        "VIRTUAL_RUN",
        "WALK",
        "WEIGHT_TRAINING",
        "WHEELCHAIR",
        "WINDSURF",
        "WORKOUT",
        "TRIATHLON",
        "DUATHLON",
        "AQUATHLON",
        "AQUABIKE",
        "OTHER"
      ]
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "startDate",
        "endDate",
        "timezone",
        "weeks"
      ],
      "properties": {
        "sourceKey": {
          "type": "string",
          "minLength": 1,
          "description": "Stable unique key for duplicate detection. Reusing it for the same athlete fails by default."
        },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "startDate": { "$ref": "#/$defs/date" },
        "endDate": { "$ref": "#/$defs/date" },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "description": "Documented timezone for the plan. The current importer stores UTC timestamps at 07:00."
        },
        "summary": {
          "type": "object",
          "additionalProperties": true,
          "description": "Human-readable/generated metadata. Not imported into workout events."
        },
        "globalRules": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "onDemandTemplates": {
          "type": "array",
          "items": { "$ref": "#/$defs/onDemandTemplate" },
          "default": []
        },
        "weeks": {
          "type": "array",
          "minItems": 1,
          "description": "Any positive number of contiguous weeks: weekly, monthly, half-year, year, etc.",
          "items": { "$ref": "#/$defs/week" }
        }
      }
    },
    "onDemandTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sport", "durationMinutes", "description"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "sport": { "$ref": "#/$defs/sport" },
        "durationMinutes": { "type": "number", "exclusiveMinimum": 0 },
        "description": { "type": "string" }
      }
    },
    "week": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weekNumber",
        "phase",
        "startDate",
        "endDate",
        "cutbackWeek",
        "benchmarkWeek",
        "sessions"
      ],
      "properties": {
        "weekNumber": { "type": "integer", "minimum": 1 },
        "phase": {
          "type": "string",
          "minLength": 1,
          "description": "Human phase label. The importer stores all cycles as OpenAthlete CyclePhase.BASE."
        },
        "startDate": { "$ref": "#/$defs/date" },
        "endDate": { "$ref": "#/$defs/date" },
        "cutbackWeek": { "type": "boolean" },
        "benchmarkWeek": { "type": "boolean" },
        "rules": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "sessions": {
          "type": "array",
          "items": { "$ref": "#/$defs/session" }
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "day",
        "type",
        "title",
        "description",
        "sport",
        "durationMinutes",
        "intensity"
      ],
      "properties": {
        "day": {
          "enum": [
            "MONDAY",
            "TUESDAY",
            "WEDNESDAY",
            "THURSDAY",
            "FRIDAY",
            "SATURDAY",
            "SUNDAY"
          ]
        },
        "type": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "sport": { "$ref": "#/$defs/sport" },
        "durationMinutes": { "type": "number", "exclusiveMinimum": 0 },
        "distanceMeters": { "type": "number", "exclusiveMinimum": 0 },
        "intensity": { "type": "string", "minLength": 1 },
        "template": { "type": "string", "minLength": 1 }
      }
    }
  }
}
